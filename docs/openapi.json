                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 60
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "csv",
                      "rest",
                      "webhook"
                    ]
                  },
                  "config": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "baseUrl": {
