                        "format": "uri"
                      },
                      "apiKey": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "type",
                  "config"
                ],
                "additionalProperties": false
              }
            }
